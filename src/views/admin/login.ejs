<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <main class="grid min-h-screen place-items-center px-4 py-12">
    <section class="w-full max-w-md rounded-[2rem] bg-white/80 p-8 shadow-float backdrop-blur-2xl">
      <a href="/" class="mb-8 inline-flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-2xl bg-slate-950 text-white shadow-soft">AG</span>
        <span class="font-black text-slate-950">Aesthetic Gallery</span>
      </a>
      <h1 class="text-3xl font-black tracking-tight text-slate-950">Login Admin</h1>
      <p class="mt-2 text-slate-600">Masuk untuk mengelola template dan melihat statistik.</p>
      <% if (error) { %>
        <p class="mt-5 rounded-2xl bg-rose-50 p-4 text-sm font-bold text-rose-600"><%= error %></p>
      <% } %>
      <form action="/admin/login" method="POST" class="mt-6 space-y-4">
        <label class="block text-sm font-black text-slate-700">Email
          <input name="email" type="email" class="input-soft mt-2" required autocomplete="email" />
        </label>
        <label class="block text-sm font-black text-slate-700">Password
          <input name="password" type="password" class="input-soft mt-2" required autocomplete="current-password" />
        </label>
        <button class="w-full rounded-full bg-slate-950 px-6 py-4 text-sm font-black text-white shadow-soft" type="submit">Masuk</button>
      </form>
      <a href="/" class="mt-5 inline-flex text-sm font-bold text-slate-500 hover:text-slate-950">Kembali ke website</a>
    </section>
  </main>
</body>
</html>
