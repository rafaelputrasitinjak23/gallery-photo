<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <main class="px-4 py-12 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl">
      <div class="mb-8 rounded-[2rem] bg-white/70 p-6 shadow-soft backdrop-blur-xl md:p-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="section-kicker">Admin panel</p>
            <h1 class="section-title">Kelola Template</h1>
            <p class="mt-3 text-slate-600">Tambah, edit, hapus, aktif/nonaktif template menggunakan JSON konfigurasi template.</p>
          </div>
          <a href="/admin" class="control-btn text-center">Dashboard</a>
        </div>
      </div>

      <div class="mb-8 rounded-[2rem] bg-white/70 p-6 shadow-soft backdrop-blur-xl">
        <h2 class="mb-3 text-xl font-black text-slate-950">Tambah / Upsert Template</h2>
        <textarea id="newTemplateJson" class="json-area" spellcheck="false"><%= sampleTemplate %></textarea>
        <button id="createTemplateBtn" class="mt-4 rounded-full bg-slate-950 px-6 py-3 text-sm font-black text-white" type="button">Simpan Template</button>
        <p id="adminMessage" class="mt-4 rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-500">Pastikan JSON valid dan tidak memuat informasi rahasia.</p>
      </div>

      <div class="grid gap-6">
        <% templates.forEach((template) => { %>
          <article class="rounded-[2rem] bg-white/70 p-5 shadow-soft backdrop-blur-xl" data-id="<%= template._id %>">
            <div class="grid gap-5 lg:grid-cols-[240px_1fr]">
              <img src="<%= template.previewImage %>" class="aspect-[4/5] w-full rounded-[1.4rem] object-cover" alt="<%= template.name %>" />
              <div>
                <div class="mb-3 flex flex-wrap gap-2">
                  <span class="pill"><%= template.category %></span>
                  <span class="pill"><%= template.ratio %></span>
                  <span class="pill"><%= template.isActive ? 'Aktif' : 'Nonaktif' %></span>
                  <span class="pill"><%= template.usageCount || 0 %> dipakai</span>
                </div>
                <h3 class="text-2xl font-black text-slate-950"><%= template.name %></h3>
                <p class="mt-2 text-sm leading-6 text-slate-600"><%= template.description %></p>
                <details class="mt-5">
                  <summary class="cursor-pointer text-sm font-black text-slate-700">Edit JSON Template</summary>
                  <textarea class="json-area template-json mt-3" spellcheck="false"><%- JSON.stringify(template, null, 2) %></textarea>
                </details>
                <div class="mt-5 flex flex-wrap gap-2">
                  <button class="update-template rounded-full bg-slate-950 px-5 py-3 text-sm font-black text-white" type="button">Update</button>
                  <button class="toggle-template control-btn" data-active="<%= !template.isActive %>" type="button"><%= template.isActive ? 'Nonaktifkan' : 'Aktifkan' %></button>
                  <button class="delete-template rounded-full bg-rose-600 px-5 py-3 text-sm font-black text-white" type="button">Hapus</button>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  </main>
  <script src="/js/gallery.js"></script>
</body>
</html>
