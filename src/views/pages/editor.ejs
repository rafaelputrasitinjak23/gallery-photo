<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <main class="px-4 py-8 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl">
      <div class="mb-6 rounded-[2rem] bg-white/70 p-6 shadow-soft backdrop-blur-xl">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="section-kicker">Canvas editor</p>
            <h1 class="text-3xl font-black tracking-tight text-slate-950 md:text-5xl"><%= template.name %></h1>
            <p class="mt-2 text-slate-600">Edit tulisan, filter, crop foto, watermark, tema warna, lalu download atau share hasil.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="downloadPngBtn" class="rounded-full bg-slate-950 px-5 py-3 text-sm font-black text-white" type="button">Download PNG</button>
            <button id="downloadJpgBtn" class="control-btn" type="button">Download JPG</button>
            <button id="shareBtn" class="control-btn" type="button">Bagikan</button>
          </div>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-[430px_1fr]">
        <aside class="space-y-5 rounded-[2rem] bg-white/70 p-5 shadow-soft backdrop-blur-xl lg:max-h-[82vh] lg:overflow-y-auto">
          <section>
            <h2 class="mb-3 text-lg font-black text-slate-950">Teks Template</h2>
            <div id="textControls" class="space-y-3"></div>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <label class="text-xs font-black uppercase tracking-[0.16em] text-slate-500">Warna teks
                <input id="textColor" type="color" value="#2c211b" class="mt-2 h-12 w-full rounded-2xl border border-slate-200 bg-white p-1" />
              </label>
              <label class="text-xs font-black uppercase tracking-[0.16em] text-slate-500">Ukuran teks
                <input id="textSize" type="number" value="34" min="16" max="120" class="input-soft mt-2" />
              </label>
            </div>
            <label class="mt-3 block text-xs font-black uppercase tracking-[0.16em] text-slate-500">Font
              <select id="fontFamily" class="input-soft mt-2">
                <option value="Inter">Inter</option>
                <option value="Playfair Display">Playfair Display</option>
                <option value="Arial">Arial</option>
                <option value="Georgia">Georgia</option>
              </select>
            </label>
          </section>

          <section>
            <div class="mb-3 flex items-center justify-between gap-3">
              <h2 class="text-lg font-black text-slate-950">Foto & Filter</h2>
              <button id="autoEnhanceBtn" class="rounded-full bg-rose-500 px-4 py-2 text-xs font-black text-white" type="button">Percantik</button>
            </div>
            <label class="text-xs font-black uppercase tracking-[0.16em] text-slate-500">Slot aktif
              <select id="activePhotoSlot" class="input-soft mt-2"></select>
            </label>
            <label class="mt-3 block text-xs font-black uppercase tracking-[0.16em] text-slate-500">Caption Foto
              <input id="photoCaption" type="text" class="input-soft mt-2" maxlength="120" />
            </label>
            <label class="mt-3 block text-xs font-black uppercase tracking-[0.16em] text-slate-500">Filter
              <select id="photoFilter" class="input-soft mt-2">
                <option value="normal">Normal</option>
                <option value="bright">Bright</option>
                <option value="warm">Warm</option>
                <option value="cool">Cool</option>
                <option value="bw">Black & White</option>
                <option value="sepia">Sepia</option>
                <option value="vintage">Vintage</option>
                <option value="soft">Soft</option>
                <option value="contrast">Contrast</option>
                <option value="fade">Fade</option>
                <option value="blur">Blur halus</option>
                <option value="enhance">Auto Enhance</option>
                <option value="creamy">Creamy</option>
                <option value="cinematic">Cinematic</option>
              </select>
            </label>
            <div class="mt-4 grid gap-3">
              <label class="range-label">Zoom <input id="photoZoom" type="range" min="0.6" max="2.8" step="0.02" value="1" /></label>
              <label class="range-label">Rotate <input id="photoRotate" type="range" min="-45" max="45" step="1" value="0" /></label>
              <label class="range-label">Geser X <input id="photoOffsetX" type="range" min="-400" max="400" step="1" value="0" /></label>
              <label class="range-label">Geser Y <input id="photoOffsetY" type="range" min="-400" max="400" step="1" value="0" /></label>
            </div>
            <p class="mt-3 rounded-2xl bg-slate-50 p-3 text-xs font-semibold leading-5 text-slate-500">Di HP, geser langsung pada canvas untuk crop. Cubit dua jari untuk zoom.</p>
            <div class="mt-5 grid grid-cols-3 gap-3">
              <button id="resetPhotoBtn" class="control-btn" type="button">Reset Crop</button>
              <button id="removePhotoBtn" class="control-btn" type="button">Hapus</button>
              <a href="/create/<%= template.slug %>" class="control-btn text-center">Ambil Ulang</a>
            </div>
          </section>

          <section>
            <h2 class="mb-3 text-lg font-black text-slate-950">Remix Tema</h2>
            <div id="themeButtons" class="grid grid-cols-2 gap-3">
              <button class="theme-preset control-btn" type="button" data-theme="default">Default</button>
              <button class="theme-preset control-btn" type="button" data-theme="cream">Cream</button>
              <button class="theme-preset control-btn" type="button" data-theme="pink">Pink</button>
              <button class="theme-preset control-btn" type="button" data-theme="blue">Blue</button>
              <button class="theme-preset control-btn" type="button" data-theme="dark">Dark</button>
              <button class="theme-preset control-btn" type="button" data-theme="minimal">Minimal</button>
            </div>
          </section>

          <section>
            <h2 class="mb-3 text-lg font-black text-slate-950">Watermark</h2>
            <label class="flex items-center gap-3 rounded-2xl bg-slate-50 p-4 text-sm font-black text-slate-700">
              <input id="watermarkEnabled" type="checkbox" class="h-5 w-5 accent-slate-950" />
              Tampilkan watermark kecil
            </label>
            <input id="watermarkText" type="text" maxlength="60" value="Aesthetic Gallery" class="input-soft mt-3" placeholder="Teks watermark" />
            <div class="mt-3 grid grid-cols-2 gap-3">
              <button id="saveDraftBtn" class="control-btn" type="button">Simpan Draft</button>
              <button id="clearDraftBtn" class="control-btn" type="button">Hapus Draft</button>
            </div>
          </section>

          <p id="saveStatus" class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-500">Perubahan akan disimpan otomatis.</p>
        </aside>

        <section class="rounded-[2rem] bg-white/70 p-5 shadow-soft backdrop-blur-xl">
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="section-kicker">Live preview</p>
              <h2 class="text-2xl font-black text-slate-950">Hasil Akhir</h2>
            </div>
            <button id="fullscreenPreviewBtn" class="control-btn" type="button">Preview Besar</button>
          </div>
          <div class="mx-auto max-h-[82vh] max-w-3xl overflow-auto rounded-[1.5rem] bg-slate-100 p-4">
            <canvas id="editorCanvas" class="touch-none mx-auto w-full rounded-[1rem] shadow-soft"></canvas>
          </div>
        </section>
      </div>
    </section>
  </main>

  <div id="editorPreviewModal" class="preview-modal hidden" role="dialog" aria-modal="true">
    <button id="closeEditorPreview" class="preview-modal-close" type="button">Tutup</button>
    <div class="preview-modal-body">
      <canvas id="bigPreviewCanvas" class="mx-auto max-h-[90vh] max-w-full rounded-[1.4rem] bg-white shadow-float"></canvas>
    </div>
  </div>

  <script id="templateData" type="application/json"><%- JSON.stringify(template).replace(/</g, '\\u003c') %></script>
  <script id="resultData" type="application/json"><%- JSON.stringify(result).replace(/</g, '\\u003c') %></script>
  <script id="todayData" type="application/json"><%- JSON.stringify(today).replace(/</g, '\\u003c') %></script>
  <script src="/js/template-renderer.js"></script>
  <script src="/js/editor.js"></script>
</body>
</html>
