<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <main>
    <section class="hero-bg overflow-hidden px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/70 bg-white/70 px-4 py-2 text-sm font-bold text-slate-600 shadow-soft backdrop-blur-xl">
            <span class="h-2 w-2 rounded-full bg-rose-400"></span>
            Kamera langsung masuk ke template estetik
          </div>
          <h1 class="max-w-3xl text-5xl font-black tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">Buat Galeri Foto Estetik dari Kamera Kamu</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">Pilih template poster, story, moodboard, atau polaroid. Ambil foto dari kamera depan/belakang, edit teks kecil, beri filter, lalu download hasil sebagai PNG atau JPG.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/templates" class="inline-flex items-center justify-center rounded-full bg-slate-950 px-7 py-4 text-sm font-black text-white shadow-soft transition hover:-translate-y-1 hover:bg-slate-800">Mulai Buat Galeri</a>
            <a href="/history" class="inline-flex items-center justify-center rounded-full border border-white/80 bg-white/70 px-7 py-4 text-sm font-black text-slate-800 shadow-soft backdrop-blur-xl transition hover:-translate-y-1">Lihat Riwayat</a>
          </div>
          <div class="mt-8 grid max-w-xl grid-cols-3 gap-3 text-center">
            <div class="stat-card"><b>10+</b><span>Template</span></div>
            <div class="stat-card"><b>2</b><span>Kamera</span></div>
            <div class="stat-card"><b>24 Jam</b><span>Auto Delete</span></div>
          </div>
        </div>
        <div class="relative min-h-[560px]">
          <% templates.slice(0, 3).forEach((template, index) => { %>
            <div class="floating-preview absolute rounded-[2rem] bg-white/75 p-4 shadow-float backdrop-blur-2xl <%= index === 0 ? 'left-8 top-6 w-64 rotate-[-7deg]' : index === 1 ? 'right-4 top-40 w-72 rotate-[5deg]' : 'bottom-8 left-24 w-72 rotate-[-2deg]' %>" style="animation-delay:<%= index * .6 %>s">
              <img src="<%= template.previewImage %>" alt="<%= template.name %>" class="aspect-[4/5] w-full rounded-[1.5rem] object-cover" />
              <div class="mt-3 flex items-center justify-between">
                <div>
                  <p class="font-black text-slate-900"><%= template.name %></p>
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400"><%= template.category %></p>
                </div>
                <span class="rounded-full bg-slate-950 px-3 py-1 text-xs font-bold text-white"><%= template.ratio %></span>
              </div>
            </div>
          <% }) %>
          <div class="absolute right-16 top-6 h-28 w-28 rounded-full bg-amber-200/60 blur-2xl"></div>
          <div class="absolute bottom-20 right-6 h-32 w-32 rounded-full bg-rose-200/70 blur-2xl"></div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="section-kicker">Template populer</p>
            <h2 class="section-title">Pilih gaya yang cocok untuk fotomu</h2>
          </div>
          <a href="/templates" class="font-black text-slate-950 underline decoration-slate-300 underline-offset-8">Lihat semua template</a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <% templates.forEach((template) => { %>
            <article class="template-card group">
              <a href="/templates/<%= template.slug %>">
                <img src="<%= template.previewImage %>" alt="<%= template.name %>" class="aspect-[4/5] w-full rounded-[1.6rem] object-cover transition duration-300 group-hover:scale-[1.02]" />
              </a>
              <div class="pt-5">
                <div class="mb-3 flex items-center gap-2">
                  <span class="pill"><%= template.category %></span>
                  <span class="pill"><%= template.ratio %></span>
                  <span class="pill"><%= template.photoSlots.length %> slot</span>
                </div>
                <h3 class="text-xl font-black text-slate-950"><%= template.name %></h3>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600"><%= template.description %></p>
                <a href="/create/<%= template.slug %>" class="mt-5 inline-flex w-full justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-black text-white transition hover:bg-slate-800">Pakai Template</a>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
