<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <main class="px-4 py-12 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl">
      <div class="mb-8 rounded-[2rem] bg-white/70 p-6 shadow-soft backdrop-blur-xl md:p-8">
        <p class="section-kicker">Riwayat browser/session</p>
        <h1 class="section-title">Hasil yang pernah dibuat</h1>
        <p class="mt-3 text-slate-600">Hasil disimpan sementara dan terhapus otomatis setelah batas waktu privasi.</p>
      </div>
      <% if (!results.length) { %>
        <div class="rounded-[2rem] bg-white/70 p-10 text-center shadow-soft backdrop-blur-xl">
          <h2 class="text-2xl font-black text-slate-950">Belum ada hasil</h2>
          <p class="mt-2 text-slate-600">Buat galeri pertamamu dari halaman template.</p>
          <a href="/templates" class="mt-6 inline-flex rounded-full bg-slate-950 px-6 py-3 text-sm font-black text-white">Pilih Template</a>
        </div>
      <% } else { %>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <% results.forEach((result) => { %>
            <article class="result-card" data-id="<%= result._id %>">
              <% const image = result.thumbnail || result.finalImage || (result.photos && result.photos[0] ? result.photos[0].dataUrl : ''); %>
              <% if (image) { %>
                <img src="<%= image %>" alt="<%= result.templateName %>" class="aspect-[4/5] w-full rounded-[1.6rem] object-cover" />
              <% } else { %>
                <div class="grid aspect-[4/5] place-items-center rounded-[1.6rem] bg-slate-100 text-slate-400">Belum ada thumbnail</div>
              <% } %>
              <div class="pt-5">
                <div class="mb-2 flex gap-2"><span class="pill"><%= result.ratio %></span><span class="pill"><%= result.photos.length %> foto</span></div>
                <h2 class="text-xl font-black text-slate-950"><%= result.templateName %></h2>
                <p class="mt-1 text-sm font-semibold text-slate-500"><%= new Date(result.createdAt).toLocaleString('id-ID') %></p>
                <div class="mt-5 grid grid-cols-2 gap-3">
                  <a href="/editor/<%= result._id %>" class="rounded-full bg-slate-950 px-5 py-3 text-center text-sm font-black text-white">Buka</a>
                  <button class="delete-result rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-800" type="button">Hapus</button>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/gallery.js"></script>
</body>
</html>
