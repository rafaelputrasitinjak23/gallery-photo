<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <main class="px-4 py-8 sm:px-6 lg:px-8">
    <% const slots = Array.isArray(template.photoSlots) ? template.photoSlots : []; %>
    <section class="mx-auto max-w-7xl">
      <div class="mb-6 rounded-[2rem] bg-white/70 p-6 shadow-soft backdrop-blur-xl">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="section-kicker">Mode kamera</p>
            <h1 class="text-3xl font-black tracking-tight text-slate-950 md:text-5xl"><%= template.name %></h1>
            <p class="mt-2 text-slate-600">Ambil foto berurutan. Foto akan langsung masuk ke slot template aktif.</p>
          </div>
          <div class="flex gap-2">
            <button id="frontCameraBtn" class="control-btn active" type="button">Kamera Depan</button>
            <button id="backCameraBtn" class="control-btn" type="button">Kamera Belakang</button>
          </div>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-[.9fr_1.1fr]">
        <section class="rounded-[2rem] bg-white/70 p-5 shadow-soft backdrop-blur-xl">
          <div class="relative overflow-hidden rounded-[1.6rem] bg-slate-950">
            <video id="cameraPreview" class="camera-video aspect-video w-full object-cover" autoplay playsinline muted></video>
            <div id="cameraOverlay" class="pointer-events-none absolute inset-0 hidden place-items-center bg-black/40 text-center text-white">
              <div>
                <div id="countdown" class="text-8xl font-black">3</div>
                <p class="font-bold">Siap ambil foto...</p>
              </div>
            </div>
            <div id="flash" class="pointer-events-none absolute inset-0 hidden bg-white"></div>
          </div>
          <p id="cameraMessage" class="mt-4 rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-600">Izinkan kamera untuk mulai mengambil foto.</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <button id="switchCameraBtn" type="button" class="control-btn">Ganti Kamera</button>
            <button id="captureBtn" type="button" class="rounded-full bg-slate-950 px-5 py-3 text-sm font-black text-white shadow-soft">Ambil Foto</button>
            <button id="openEditorBtn" type="button" class="control-btn" disabled>Lanjut Editor</button>
          </div>
          <div class="mt-5">
            <p class="mb-3 text-sm font-black text-slate-700">Pilih slot aktif</p>
            <div id="slotButtons" class="flex flex-wrap gap-2"></div>
          </div>
        </section>

        <section class="rounded-[2rem] bg-white/70 p-5 shadow-soft backdrop-blur-xl">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div>
              <p class="section-kicker">Preview template</p>
              <h2 class="text-2xl font-black text-slate-950">Foto melayang otomatis</h2>
            </div>
            <span id="slotProgress" class="rounded-full bg-slate-950 px-4 py-2 text-xs font-black text-white">0/<%= slots.length %></span>
          </div>
          <div class="mx-auto max-h-[72vh] max-w-xl overflow-auto rounded-[1.5rem] bg-slate-100 p-4">
            <canvas id="templateCanvas" class="mx-auto w-full rounded-[1rem] shadow-soft"></canvas>
          </div>
        </section>
      </div>
    </section>
  </main>
  <script id="templateData" type="application/json"><%- JSON.stringify(template).replace(/</g, '\\u003c') %></script>
  <script id="todayData" type="application/json"><%- JSON.stringify(today).replace(/</g, '\\u003c') %></script>
  <script src="/js/template-renderer.js" defer></script>
  <script src="/js/camera.js" defer></script>
</body>
</html>
