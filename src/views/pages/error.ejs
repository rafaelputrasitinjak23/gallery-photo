<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <main class="min-h-[70vh] px-4 py-20">
    <section class="mx-auto max-w-2xl rounded-[2rem] bg-white/80 p-8 text-center shadow-soft backdrop-blur-xl">
      <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-3xl bg-rose-100 text-rose-600">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M12 9v4m0 4h.01M10.3 4.3 2.8 17.1A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.9L13.7 4.3a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="text-3xl font-black tracking-tight text-slate-950"><%= title %></h1>
      <p class="mt-3 text-slate-600"><%= message %></p>
      <a href="/templates" class="mt-8 inline-flex rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white">Pilih Template</a>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
